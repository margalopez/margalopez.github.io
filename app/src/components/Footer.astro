---
export const socials = [{
        icon: 'i-simple-icons:linkedin',
        url: 'https://www.linkedin.com/in/marga-l%C3%B3pez-27781684/',
        owner: 'personal'
    },
    {
        icon: 'i-simple-icons:github',
        url: 'https://github.com/margalopez',
        owner: 'personal'
    },
    {
        icon: 'i-simple-icons:itchdotio',
        url: 'https://paperets.itch.io/',
        owner: 'paperets'
    },
    {
        icon: 'i-simple-icons:kofi',
        url: 'https://ko-fi.com/paperets',
        owner: 'paperets'
    },
    {
        icon: 'i-simple-icons:youtube',
        url: 'https://www.youtube.com/@paperets_dev',
        owner: 'paperets'
    },
    {
        icon: 'i-simple-icons:instagram',
        url: 'https://www.instagram.com/paperets_dev/',
        owner: 'paperets'
    },
];


const socialsPersonal = socials.filter(_ => _.owner === 'personal');
const socialsPaperets = socials.filter(_ => _.owner === 'paperets');
---

<footer class="footer">
    <div class="footer__content">
        <div class="footer__column">
            <p>Handcrafted with <span>♥</span>.</p>
            <p>© 2026 Marga López. All rights reserved.</p>
        </div>
    
        <div class="footer__column footer__column--right">
            <p>Get in touch with <span>me</span> :)</p>
            <div class="footer__social">
                {socialsPersonal.map((social) => (
                    <a
                        class="footer__social-link"
                        href={social.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <p class={social.icon}></p>
                    </a>
                ))}
            </div>
    
            <p>Follow my journey as an <span>indie game dev</span> ^o^</p>
            <div class="footer__social">
                {socialsPaperets.map((social) => (
                    <a
                        class="footer__social-link"
                        href={social.url}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <p class={social.icon}></p>
                    </a>
                ))}
            </div>
        </div>
    </div>
</footer>

<style lang="scss">
    .footer {
        @apply bg-boxes py-section;
        
        &__content {
            @apply layout md:flex items-end;
        }

        &__column {
            @apply mb-6 md:mb-0 md:w-50%;

            &--right {
                @apply mb-0;

                p {
                    @apply md:text-right;
                }
            }

            span {
                @apply text-secondary;
            }
        }

        &__social {
            @apply flex md:justify-end gap-4 mb-4.5 last:mb-0;

            &-link {
                @apply text-foreground hover:text-primary transition-colors duration-300;

                p {
                    @apply w-6 h-6;
                }
            }
        }
    }
</style>